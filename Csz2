-- Função para converter posição 3D para 2D na tela
local function WorldToViewportPoint(position)
    local camera = workspace.CurrentCamera
    local screenPos, onScreen = camera:WorldToViewportPoint(position)
    return screenPos, onScreen
end

-- Função para desenhar uma caixa 3D (aproximação usando linhas)
local function Get3DBoxPoints(hrp)
    local size = Vector3.new(4, 7, 2)
    local corners = {
        Vector3.new(-size.X/2, -size.Y/2, -size.Z/2),
        Vector3.new(size.X/2, -size.Y/2, -size.Z/2),
        Vector3.new(size.X/2, size.Y/2, -size.Z/2),
        Vector3.new(-size.X/2, size.Y/2, -size.Z/2),
        Vector3.new(-size.X/2, -size.Y/2, size.Z/2),
        Vector3.new(size.X/2, -size.Y/2, size.Z/2),
        Vector3.new(size.X/2, size.Y/2, size.Z/2),
        Vector3.new(-size.X/2, size.Y/2, size.Z/2),
    }
    local points = {}
    for i, corner in ipairs(corners) do
        local world = hrp.CFrame:PointToWorldSpace(corner)
        local screen, onScreen = WorldToViewportPoint(world)
        points[i] = {screen, onScreen}
    end
    return points
end

-- Cria/desenha linhas para a caixa 3D
local function Update3DBoxLines(lines, points)
    local edges = {
        {1,2},{2,3},{3,4},{4,1},
        {5,6},{6,7},{7,8},{8,5},
        {1,5},{2,6},{3,7},{4,8}
    }
    for i, edge in ipairs(edges) do
        local a, b = points[edge[1]], points[edge[2]]
        if a[2] and b[2] then
            lines[i].From = Vector2.new(a[1].X, a[1].Y)
            lines[i].To = Vector2.new(b[1].X, b[1].Y)
            lines[i].Visible = true
        else
            lines[i].Visible = false
        end
    end
end

