-- Função para verificar se o jogador é inimigo (baseado em Shirt ou BodyColors)
local function isEnemy(player)
    if not player.Character or not LocalPlayer.Character then return false end

    -- Tenta pegar a Shirt dos dois jogadores
    local myShirt = LocalPlayer.Character:FindFirstChildOfClass("Shirt")
    local theirShirt = player.Character:FindFirstChildOfClass("Shirt")

    if myShirt and theirShirt then
        -- Compara o template da camisa (URL do asset)
        return myShirt.ShirtTemplate ~= theirShirt.ShirtTemplate
    end

    -- Se não tiver Shirt, tenta comparar BodyColors (cor do torso)
    local myBody = LocalPlayer.Character:FindFirstChildOfClass("BodyColors")
    local theirBody = player.Character:FindFirstChildOfClass("BodyColors")
    if myBody and theirBody then
        return myBody.TorsoColor ~= theirBody.TorsoColor
    end

    -- Se não conseguir comparar, não mostra ESP
    return false
end

