-- Atualiza lista de jogadores a cada 1 segundo
task.spawn(function()
    while true do
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and not trackedPlayers[player] and isEnemy(player) then
                -- Adicione ao trackedPlayers:
                trackedPlayers[player] = {
                    boxLines = CreateBoxLines(),
                    headCircle = CreateHeadCircle(),
                    nameText = CreateNameText(),
                    distanceText = CreateDistanceText(), -- NOVO
                }
            end
        end
        -- Remove jogadores que saíram
        for player, objs in pairs(trackedPlayers) do
            if not Players:FindFirstChild(player.Name) then
                for _, l in ipairs(objs.boxLines) do l:Remove() end
                objs.headCircle:Remove()
                trackedPlayers[player] = nil
            end
        end
        task.wait(1)
    end
end)

-- Atualiza ESP a cada frame
RunService.RenderStepped:Connect(function()
    if getgenv().ESPEnabled then
        for player, objs in pairs(trackedPlayers) do
            if isEnemy(player) and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Head") then
                local char = player.Character
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local head = char:FindFirstChild("Head")
                local points = Get3DBoxPoints(hrp)
                -- Box
                if getgenv().ESPBox then
                    Update3DBoxLines(objs.boxLines, points)
                else
                    for _, l in ipairs(objs.boxLines) do l.Visible = false end
                end
                -- Head hitbox
                local camera = workspace.CurrentCamera
                local headPos, onScreen = camera:WorldToViewportPoint(head.Position)
                local distance = (camera.CFrame.Position - head.Position).Magnitude
                local scale = math.clamp(60 / distance, 6, 18)
                if getgenv().ESPHead and onScreen then
                    objs.headCircle.Position = Vector2.new(headPos.X, headPos.Y)
                    objs.headCircle.Radius = scale
                    objs.headCircle.Visible = true
                else
                    objs.headCircle.Visible = false
                end
                -- Name
                if getgenv().ESPName and onScreen then
                    objs.nameText.Position = Vector2.new(headPos.X, headPos.Y - 25)
                    objs.nameText.Text = player.Name
                    objs.nameText.Visible = true
                else
                    objs.nameText.Visible = false
                end
                -- Distance
                local minY, maxY = math.huge, -math.huge
                local minX, maxX = math.huge, -math.huge
                for _, pt in ipairs(points) do
                    if pt[2] then
                        minY = math.min(minY, pt[1].Y)
                        maxY = math.max(maxY, pt[1].Y)
                        minX = math.min(minX, pt[1].X)
                        maxX = math.max(maxX, pt[1].X)
                    end
                end
                if getgenv().ESPDistance and onScreen then
                    objs.distanceText.Position = Vector2.new((minX + maxX)/2, maxY + 10)
                    objs.distanceText.Text = string.format("%.1f m", distance / 20)
                    objs.distanceText.Visible = true
                else
                    objs.distanceText.Visible = false
                end
            else
                for _, l in ipairs(objs.boxLines) do l.Visible = false end
                objs.headCircle.Visible = false
                objs.nameText.Visible = false
                objs.distanceText.Visible = false
            end
        end
    else
        for player, objs in pairs(trackedPlayers) do
            for _, l in ipairs(objs.boxLines) do l.Visible = false end
            objs.headCircle.Visible = false
            objs.nameText.Visible = false
            objs.distanceText.Visible = false
        end
    end
end)

